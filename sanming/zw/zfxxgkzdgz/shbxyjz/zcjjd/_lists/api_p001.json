e": "", "type": 20, "url": "http://rsj.sm.gov.cn/xxgk/tzgg/202005/t20200506_1527467.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://rsj.sm.gov.cn/xxgk/tzgg/202005/", "rels": []}, {"docid2": 1524930, "bgxz": "", "chnl": "政策及解读", "chnldocurl": "http://rsj.sm.gov.cn/xxgk/tzgg/202004/t20200424_1524930.htm", "content": "\n　　为全面贯彻党中央有关统筹推进新冠肺炎疫情防控和经济社会发展的决策部署，根据《福建省劳动能力鉴定中心关于全省劳动能力鉴定工作有关事项的通知》（闽劳鉴文〔2020〕1号），现就做好当前和今后一段时间我市劳", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://rsj.sm.gov.cn/xxgk/tzgg/202004/t20200424_1524930.htm", "docreltime": "2020.04.24 15:00:00", "doctitle": "三明市劳动能力鉴定委员会关于逐步恢复开展劳动能力现场鉴定工作的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 2, "pubdate": "", "puborg": "", "recid": 1648298, "sourcename": "三明市人力资源和社会保障局", "subdoctitle": "", "type": 20, "url": "http://rsj.sm.gov.cn/xxgk/tzgg/202004/t20200424_1524930.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "现场鉴定指南.doc", "appdocid": 1524930, "appfile": "P020200424540164602296.doc", "appflag": 10, "appsern": 1, "docpuburl": "http://rsj.sm.gov.cn/xxgk/tzgg/202004/t20200424_1524930.htm", "fileext": "doc", "_src": "/protect/P0202004/P020200424/P020200424540164602296.doc", "_href": "http://rsj.sm.gov.cn/xxgk/tzgg/202004/P020200424540164602296.doc"}], "_docpuburl": "http://rsj.sm.gov.cn/xxgk/tzgg/202004/", "rels": []}, {"docid2": 1524141, "bgxz": "", "chnl": "政策及解读", "chnldocurl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202004/t20200422_1524141.htm", "content": "\n　　市直各参保单位： \n　　根据《福建省人民政府关于印发贯彻落实<国务院关于机关事业单位工作人员养老保险制度改革的决定>实施办法》的通知（闽政〔2015〕48号）以及《福建省人力资源和社会保障厅转发人力资源社会", "docabstract": "规范机关事业单位养老保险待遇核定工作", "doclogo": "", "docpeople": "", "docpuburl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202004/t20200422_1524141.htm", "docreltime": "2020.04.22 11:48:00", "doctitle": "关于规范机关事业单位养老保险待遇核定工作的通知", "doctype": 20, "efftype": "", "fileno": "明人社〔2020〕164号", "idxid": "SM00113-40-2020-00064", "itvid": "", "modal": 2, "pubd