　场内58个招聘展位吸引了来自福州、泉州、三明等地58家企业参会，共提供就业岗位3364个，涉及制造业、电", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "", "docreltime": "2018.03.12 08:45:00", "doctitle": "我市举办2018年山海协作暨春季大中专毕业生专场招聘月活动", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 3, "pubdate": "", "puborg": "", "recid": 1137551, "sourcename": "市人力资源和社会保障局", "subdoctitle": "", "type": 20, "url": "", "ztcx": "", "tpfl": "", "pics": [{"appdesc": "W020180312323194050300.jpg", "appdocid": 1087380, "appfile": "W020180312323194050300.jpg", "appflag": 20, "appsern": 1, "docpuburl": "", "fileext": "jpg", "_src": "/webpic/W0201803/W020180312/W020180312323194050300.jpg", "_href": "W020180312323194050300.jpg"}], "files": [], "_docpuburl": "", "_firstpic": "W020180312323194050300.jpg", "rels": []}, {"docid2": 1083481, "bgxz": "", "chnl": "就业专项活动", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jycy/jyzxhd/201802/t20180226_1083481.htm", "content": "\n　　2月24日（正月初九），由市人社局主办的2018年首场就业援助招聘会在市人力资源市场成功举办。 \n　　招聘会场内58个展位全部入驻，共吸引三钢集团、省一建、双轮化机等58家企业参与，为广大求职人员提供就业岗位", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "", "docreltime": "2018.02.26 11:20:00", "doctitle": "我市新春首场就业援助招聘会人气爆棚", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 3, "pubdate": "", "puborg": "", "recid": 1133127, "sourcename": "市人力资源和社会保障局", "subdoctitle": "", "type": 20, "url": "", "ztcx": "", "tpfl": "", "pics": [{"appdesc": "W020180226.jpg", "appdocid": 1083481, "appfile": "W020180302346013049894.jpg", "appflag": 20, "appsern": 1, "docpuburl": "", "fileext": "jpg", "_src": "/webpic/W0201803/W020180302/W020180302346013049894.jpg", "_href": "W020180302346013049894.jpg"}], "files": [], "_docpuburl": "", "_firstpic": "W020180302346013049894.jpg", "rels": []}]}