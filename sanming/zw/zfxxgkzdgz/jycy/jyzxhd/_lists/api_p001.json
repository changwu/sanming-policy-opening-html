sm.gov.cn/zw/zwxx/sjdt/202410/", "rels": []}, {"docid2": 2052680, "bgxz": "", "chnl": "就业专项活动", "chnldocurl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202408/t20240821_2052680.htm", "content": "\n　　各县（市、区）人力资源和社会保障局（民政和人力资源社会保障局）：\n　　为贯彻落实党的二十届三中全会精神，进一步优化创业促进就业政策环境，深入实施重点群体创业推进行动，激发有创业意愿的高校毕业生、返", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202408/t20240821_2052680.htm", "docreltime": "2024.08.21 16:00:00", "doctitle": "关于进一步提升“源来好创业”资源对接服务季活动实效的通知", "doctype": 20, "efftype": "", "fileno": "明人社〔2024〕159号", "idxid": "SM00113-40-2024-00080", "itvid": "", "modal": 2, "pubdate": "2024.07.31 00:00:00", "puborg": "三明市人力资源和社会保障局", "recid": 2250177, "sourcename": "三明市人力资源和社会保障局", "subdoctitle": "", "type": 20, "url": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202408/t20240821_2052680.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [{"appdesc": "附件.docx", "appdocid": 2052680, "appfile": "P020240821586379078144.docx", "appflag": 10, "appsern": 1, "docpuburl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202408/t20240821_2052680.htm", "fileext": "docx", "_src": "/protect/P0202408/P020240821/P020240821586379078144.docx", "_href": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202408/P020240821586379078144.docx"}], "_docpuburl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202408/", "rels": []}, {"docid2": 2047906, "bgxz": "", "chnl": "就业专项活动", "chnldocurl": "http://rsj.sm.gov.cn/xxgk/tzgg/202408/t20240802_2047906.htm", "content": "\n　　为促进三明市区高质量发展，引导优秀高校毕业生来明就业创业，为重点企事业单位拓宽择优选才渠道，为明籍高校学子创造岗位锻炼机会，根据《三明市人力资源和社会保障局关于开展“职引未来·筑梦三明”高校毕业生", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://rsj.sm.gov.cn/xxgk/tzgg/202408/t20240802_2047906.htm", "docreltime": "2024.08.02 09:57:00", "doctitle": "三明市人力资源和社会保障局关于开展高校毕业生就业见习系列活动（第一期）的通告", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 2, "pubdate": "", "puborg": "", "recid": 2226707, "sourcename": "三明市人力资源和社会保障局", "subdoctitle": "", "type": 20, "url": "http://r