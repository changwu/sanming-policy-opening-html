207.docx"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202105/", "rels": []}, {"docid2": 1548431, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202007/t20200707_1548431.htm", "content": "\n　　县招生委员会各成员单位：\n　　现将《明溪县2020年城区公办幼儿园及义务教育学校招生工作意见》印发给你们，请认真贯彻执行。\n　　明溪县招生委员会\n　　2020年6月12日\n　　明溪县2020年城区公办幼儿园及义务教", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202007/t20200707_1548431.htm", "docreltime": "2020.06.15 17:12:00", "doctitle": "明溪县招生委员会关于印发明溪县2020年城区公办幼儿园及义务教育学校招生工作意见的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1630637, "sourcename": "市教育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202007/t20200707_1548431.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "明招委[2020]2号附件.docx", "appdocid": 1548431, "appfile": "P020200707551712176575.docx", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202007/t20200707_1548431.htm", "fileext": "docx", "_src": "/protect/P0202007/P020200707/P020200707551712176575.docx", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202007/P020200707551712176575.docx"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202007/", "rels": []}, {"docid2": 1536782, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202006/t20200601_1536782.htm", "content": "\n　　明教初〔2020〕68号 \n　　各县（市、区）教育局，市直属幼儿园：\n　　为认真贯彻《中共中央国务院关于学前教育深化改革规范发展的若干意见》及《福建省教育厅关于落实〈福建省学前教育深化改革规范发展的实施方", "docabstract": "2020年  秋季幼儿园  招生工作", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202006/t20200601_1536782.htm", "docreltime": "2020.06.01 11:27:00", "doctitle": "三明市教育局关于做好2020年秋季幼儿园招生工作的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 161