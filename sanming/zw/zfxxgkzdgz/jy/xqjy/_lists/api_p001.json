427285267669781.docx"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202204/", "rels": []}, {"docid2": 1786854, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202205/t20220515_1786854.htm", "content": "\n　　近日，省教育厅会同省委编办、省财政厅、省人社厅印发《关于进一步做好全省中小学幼儿园教师补充工作的若干措施》（以下简称《若干措施》），现解读如下。\n　　一、出台背景\n　　为进一步健全我省中小学幼儿园教", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202205/t20220515_1786854.htm", "docreltime": "2022.03.30 15:38:00", "doctitle": "《福建省教育厅 中共福建省委机构编制委员会办公室 福建省财政厅 福建省人力资源和社会保障厅印发<关于进一步做好全省中小学幼儿园教师补充工作的若干措施>的通知》政策解读", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1911435, "sourcename": "市教育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202205/t20220515_1786854.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202205/", "rels": []}, {"docid2": 1761734, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761734.htm", "content": "\n　　近日，省教育厅印发了《福建省示范性幼儿园评估办法（修订）》（以下简称《评估办法》）《福建省示范性幼儿园评估标准（修订）》（以下简称《评估标准》），现将有关政策解读如下：\n　　一、修订背景  \n　　——", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761734.htm", "docreltime": "2022.01.18 08:29:00", "doctitle": "关于《福建省示范性幼儿园评估办法》（修订）》《福建省示范性幼儿园评估标准（修订）》政策解读", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1881521, "sourcename": "市教育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761734.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/", "rels": []}, {"docid2": 1761752, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761752.htm", "content": "\n　　明教初〔2022〕1号\n　　各县（市、区）教育局：\n　　    为贯彻落实《教育部等九部门关于印发<“十四五”学前教育发展提升行动计划>的通知》（教基〔2021〕8号）、《福建省教育厅关于进一步加强乡村学前教育办学", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761752.htm", "docreltime": "2022.01.12 09:28:00", "doctitle": "三明市教育局关于推进乡村学前教育办学点标准化建设与评估工作的通知", "doctype": 20, "efftype": "", "fileno": "明教初〔2022〕1号", "idxid": "SM00104-0200-2022-00003", "itvid": "", "modal": 1, "pubdate": "2022.01.07 00:00:00", "puborg": "三明市教育局", "recid": 1881539, "sourcename": "市教育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761752.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [{"appdesc": "附件1-4.docx", "appdocid": 1761752, "appfile": "P020220302621443251063.docx", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761752.htm", "fileext": "docx", "_src": "/protect/P0202203/P020220302/P020220302621443251063.docx", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/P020220302621443251063.docx"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/", "rels": []}, {"docid2": 1761750, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761750.htm", "content": "\n　　明教初〔2021〕260号\n　　各县（市、区）教育局：\n　　在将乐县艺术幼儿园、清流县长校中心幼儿园、清流县灵地中心幼儿园自主申报和相关县教育局资格审查并经公示无异议的基础上，我局于2021年11月10日、25日至", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761750.htm", "docreltime": "2021.12.29 14:26:00", "doctitle": "三明市教育局关于确认将乐县艺术幼儿园等三所幼儿园为三明市示范幼儿园的通知", "doctype": 20, "efftype": "", "fileno": "明教初〔2021〕260号", "idxid": "SM00104-0200-2021-00206", "itvid": "", "modal": 1, "pubdate": "2021.12.28 00:00:00", "puborg": "三明市教育局", "recid": 1881537, "sourcename": "市教育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761750.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/", "rels": []}, {"docid2": 1761732, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761732.htm", "content": "\n　　近日，教育部、国家发展改革委、财政部等九部门印发了《“十四五”学前教育发展提升行动计划》（以下简称“学前提升计划”），教育部基础教育司负责人就有关问题回答了记者提问。\n　　1.请介绍一下编制实施“学", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761732.htm", "docreltime": "2021.12.20 11:39:00", "doctitle": "教育部基础教育司负责人就《“十四五”学前教育发展提升行动计划》答记者问", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1881519, "sourcename": "市教育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/t20220302_1761732.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202203/", "rels": []}, {"docid2": 1684019, "bgxz": "", "chnl": "学前教育", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202107/t20210713_1684019.htm", "content": "\n　　辖区各公办幼儿园：\n　　为了保持城区公办幼儿园招生工作的延续性和稳定性，2021年三元区将按“三元区北部片区(原梅列辖区)”和“三元区南部片区（原三元辖区）” 分别组织实施招生，请认真抓好贯彻落实。\n　　", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202107/t20210713_1684019.htm", "docreltime": "2021.07.13 17:52:00", "doctitle": "三元区招委会关于印发《2021年三元区城区公办幼儿园招生工作方案》的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1789248, "sourcename": "市教育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/jy/xqjy/202107/t20210713_1684019.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "2021年三元区北部片区（原梅列辖区）城区公办幼儿园招生工作方案.doc", "appdocid": 1684019, "appfile": "P020210713644603271933.doc", "appflag": 10,