2646.htm", "fileext": "doc", "_src": "/protect/P0202309/P020230912/P020230912631302374921.doc", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202309/P020230912631302374921.doc"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202309/", "rels": []}, {"docid2": 1942642, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202309/t20230912_1942642.htm", "content": "\n　　市直各有关单位：\n　　鉴于人事变动，经研究决定调整三明市全民阅读工作组织委员会成员，现将调整后的成员名单通知如下：\n　　三明市全民阅读工作组织委员会成员\n　　组    长：陈列平  市委常委、宣传部长\n　　", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202309/t20230912_1942642.htm", "docreltime": "2023.05.17 17:23:00", "doctitle": "三明市文化和旅游局关于调整三明市全民阅读工作组织委员会成员名单的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2102610, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202309/t20230912_1942642.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202309/", "rels": []}, {"docid2": 1897014, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202304/t20230417_1897014.htm", "content": "\n　　各县（市、区）文体和旅游局，局属各相关单位：\n　　《“首届沪明非遗美食文化旅游节”活动方案》经局党组研究同意，现印发给你们，请认真组织实施。\n　　附件：“首届沪明非遗美食文化旅游节”活动方案\n　　三", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202304/t20230417_1897014.htm", "docreltime": "2023.03.17 19:56:00", "doctitle": "三明市文化和旅游局关于印发《“首届沪明非遗美食文化旅游节”活动方案》的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2045855, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202304/t20230417_1897014.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [],