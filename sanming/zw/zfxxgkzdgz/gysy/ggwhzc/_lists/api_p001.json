19_1778232.htm", "docreltime": "2022.03.11 10:34:00", "doctitle": "三明市文化和旅游局 三明市教育局 关于三明市首届非物质文化遗产创意作品大赛的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1901353, "sourcename": "三明市文化和旅游局网站", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202204/t20220419_1778232.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "明文旅〔2022〕18号（三明市文化和旅游局 三明市教育局关于三明市首届非物质文化遗产创意作品大赛的通知）附件.doc", "appdocid": 1778232, "appfile": "P020220419381964857270.doc", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202204/t20220419_1778232.htm", "fileext": "doc", "_src": "/protect/P0202204/P020220419/P020220419381964857270.doc", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202204/P020220419381964857270.doc"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202204/", "rels": []}, {"docid2": 1732301, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/t20211129_1732301.htm", "content": "\n　　福建艺术节是由福建省人民政府主办、省文旅厅等单位承办的我省规格最高、规模最大的综合性文化艺术创作演出展示活动，每三年举办一届，对推动我省艺术事业的繁荣发展具有重要作用。第八届福建艺术节定于2021年1", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/t20211129_1732301.htm", "docreltime": "2021.11.29 19:01:00", "doctitle": "第八届福建艺术节三明分会场活动方案", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1847518, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/t20211129_1732301.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/", "rels": []}, {"docid2": 1734550, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734550.htm", "content": "\n　　各县（市、区）委宣传部、文体和旅游局，市客家文化艺术中心：\n　　为庆祝中国共产党成立100周年，市委宣传部、市文旅局定于2021年5月中旬开始开展“永远跟党走”文化进万家流动舞台车巡演活动。现将有关事项通", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734550.htm", "docreltime": "2021.05.10 17:54:00", "doctitle": "中共三明市委宣传部  三明市文化和旅游局关于开展“永远跟党走”2021年三明市文化进万家流动舞台车巡演活动的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1850296, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734550.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "明文旅〔2021〕41号附件.docx", "appdocid": 1734550, "appfile": "P020211206646584496619.docx", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734550.htm", "fileext": "docx", "_src": "/protect/P0202112/P020211206/P020211206646584496619.docx", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/P020211206646584496619.docx"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/", "rels": []}, {"docid2": 1734547, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734547.htm", "content": "\n　　各县（市、区）文体和旅游局：\n　　根据国务院办公厅《关于推进基层综合性文化服务中心的指导意见》，省委办公厅、省政府办公厅《关于推进基层综合性文化服务中心建设实施方案》要求，为推进我市基层综合文化服", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734547.htm", "docreltime": "2020.12.11 17:47:00", "doctitle": "三明市文化和旅游局关于公布2020年度三明市基层综合文化服务中心优秀示范点名单的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1850293, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734547.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "明文旅〔2020〕182号附件.docx", "appdocid": 1734547, "appfile": "P020211206643076376176.docx", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734547.htm", "fileext": "docx", "_src": "/protect/P0202112/P020211206/P020211206643076376176.docx", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/P020211206643076376176.docx"}], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/", "rels": []}, {"docid2": 1731443, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/t20211126_1731443.htm", "content": "\n　　根据省、市体育局关于《福建省体育局应对新冠肺炎疫情防控工作领导小组转发国家体育总局关于有序恢复体育赛事的指导意见的通知》精神，三元区文体和旅游局按照“外防输入、内防反弹”的疫情防控要求，落实落细疫", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/t20211126_1731443.htm", "docreltime": "2020.06.22 21:43:00", "doctitle": "三元区文体和旅游局对辖区体育场所开展防疫工作检查", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1846362, "sourcename": "三明市体育局网站", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/t20211126_1731443.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202111/", "rels": []}, {"docid2": 1734542, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734542.htm", "content": "\n　　梅列区、三元区文体和旅游局、市客家文化艺术中心：\n　　根据市政府办《关于印发加快三明市区夜间经济发展实施方案的通知》（明政办〔2020〕25号）精神，现将《“夜三明”百姓大舞台文化活动工作方案》印发给你", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734542.htm", "docreltime": "2020.05.20 17:43:00", "doctitle": "三明市文化和旅游局关于印发“夜三明”百姓大舞台文化活动工作方案的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1850287, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734542.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/", "rels": []}, {"docid2": 1743725, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743725.htm", "content": "\n　　各县（市、区）文体和旅游局： \n　　2020年，我局将结合三明城市名片宣传推广工作和疫后宣传促销的需要，进一步提升“中国绿都·最氧三明四季行”年度大型主题营销活动，采取“主题定位+产品创意+活动策划+线上", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743725.htm", "docreltime": "2020.04.20 16:05:00", "doctitle": "三明市文化和旅游局关于印发《2020年“中国绿都·最氧三明四季行”年度大型主题营销活动实施方案》的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1861027, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743725.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/", "rels": []}, {"docid2": 1743603, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743603.htm", "content": "\n　　各县（市、区）文体和旅游局、总工会： \n　　现将《三明市面向省内、闽粤赣三省十三市合作区职工疗休养优惠政策》印发给你们，请组织辖区内职工疗休养基地、景区、旅行社认真学习、抓好落实，全力拓展省内、闽粤", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743603.htm", "docreltime": "2020.03.11 14:50:00", "doctitle": "三明市文化和旅游局  三明市总工会 关于印发面向省内、闽粤赣三省十三市合作区职工疗休养优惠政策的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1860901, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743603.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/", "rels": []}, {"docid2": 1743601, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743601.htm", "content": "\n　　各县（市、区）文体和旅游局，局属各单位、机关各科室： \n　　现将《关于应对新冠肺炎疫情支持文旅产业平稳健康发展的工作方案》印发给你们，请认真贯彻执行。 \n　　三明市文化和旅游局\n　　2020年2月19日\n　　", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743601.htm", "docreltime": "2020.02.20 14:47:00", "doctitle": "三明市文化和旅游局印发关于应对新冠肺炎疫情支持文旅产业平稳健康发展的工作方案的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1860899, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211229_1743601.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/", "rels": []}, {"docid2": 1734540, "bgxz": "", "chnl": "公共文化政策", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734540.htm", "content": "\n　　各县（市、区）宣传部、文明办、教育局、财政局、农业农村局、文旅局（新闻出版广电局）、团委、妇联、残联、福建新华发行（集团）有限责任公司三明分公司： \n　　现将三明市农家书屋深化改革创新提升服务效能实", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734540.htm", "docreltime": "2019.10.08 17:33:00", "doctitle": "关于印发三明市农家书屋深化改革创新提升服务效能实施办法", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1850285, "sourcename": "三明市文化和旅游局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/t20211206_1734540.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggwhzc/202112/", "rels": []}]}