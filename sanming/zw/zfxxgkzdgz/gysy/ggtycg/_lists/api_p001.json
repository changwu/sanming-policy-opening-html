2.htm", "fileext": "png", "_src": "/webpic/W0202111/W020211123/W020211123346091718748.png", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/W020211123346091718748.png"}], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "_firstpic": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/W020211123346091718748.png", "rels": []}, {"docid2": 1729725, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729725.htm", "content": "\n　　为确保师生的生命安全和身体健康，根据上级主管部门开学复课的要求，三明市少体校把疫情防控作为返校复学第一课的首要内容。严格按照《福建省春季学期开学准备工作评估导则》要求做好开学评估，确保责任到位、措", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729725.htm", "docreltime": "2020.05.13 08:45:00", "doctitle": "科学防疫 从我做起-----市少体校防疫安全“开学第一课”", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843859, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729725.htm", "ztcx": "", "tpfl": "", "pics": [{"appdesc": "微信图片_20200513084511.jpg", "appdocid": 1729725, "appfile": "W020211123347048723309.jpg", "appflag": 20, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729725.htm", "fileext": "jpg", "_src": "/webpic/W0202111/W020211123/W020211123347048723309.jpg", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/W020211123347048723309.jpg"}, {"appdesc": "微信图片_20200513084459.jpg", "appdocid": 1729725, "appfile": "W020211123347049171689.jpg", "appflag": 20, "appsern": 2, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729725.htm", "fileext": "jpg", "_src": "/webpic/W0202111/W020211123/W020211123347049171689.jpg", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/W020211123347049171689.jpg"}], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "_firstpic": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/W020211123347048723309.jpg", "rels": []}, {"docid2": 1729721, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729721.htm", "content": "\n　　为了满足人民群众健身场地需求，提升市民健身条件，市体育局积极申报省上为民办实事项目，共争取到2020年全民健身场地设施建设项目指标12个，其中：全民健身中心1个，智慧体育公园3个，笼式足球场8个，共争取省", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729721.htm", "docreltime": "2020.04.30 17:18:00", "doctitle": "市体育局积极争取省上为民办实事项目", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843855, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729721.htm", "ztcx": "", "tpfl": "", "pics": [{"appdesc": "图片1.png", "appdocid": 1729721, "appfile": "W020211123346087695231.png", "appflag": 20, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729721.htm", "fileext": "png", "_src": "/webpic/W0202111/W020211123/W020211123346087695231.png", "_href": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/W020211123346087695231.png"}], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "_firstpic": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/W020211123346087695231.png", "rels": []}, {"docid2": 1729723, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729723.htm", "content": "\n　　三明市梅列区委、区政府重视对区老年体育设施建设，将场地建设提上日程，在中共梅列区委2018年第25号会议纪要中，同意将陈大瑞云社区、重化社区、龙祥小区3个门球场和东乾社区气排球场等老年体育设施改造提升项", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729723.htm", "docreltime": "2018.11.28 20:11:00", "doctitle": "三明市梅列区改造提升老年体育设施", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843857, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729723.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "rels": []}, {"docid2": 1729720, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729720.htm", "content": "\n　　1、梅列区：\n　　三明体育馆健身气功活动站点\n　　梅列区少体校健身气功培训站点\n　　梅列区重化社区健身气功培训站\n　　青山健身气功培训点\n　　三钢青山二村健身气功培训点\n　　洋溪镇健身气功培训站点\n　　2", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729720.htm", "docreltime": "2016.07.28 20:09:00", "doctitle": "三明市全民健身站点明细表", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843854, "sourcename": "三明市体育局网站", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729720.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "rels": []}, {"docid2": 1729844, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729844.htm", "content": "\n　　三明市下洋健身中心游泳馆是目前全市规模最大、设施最完善、功能最齐全游泳馆，更是游泳健身爱好者的最好去处。\n　　泳馆位于新市中路（市住建局对面），交通便捷、环境优美、占地2890㎡。泳馆拥有国际标准的10", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729844.htm", "docreltime": "2013.07.10 10:34:00", "doctitle": "下洋体育健身中心恒温游泳馆", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1844066, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729844.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "rels": []}, {"docid2": 1729836, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729836.htm", "content": "\n　　场馆地点\n　　场馆简介\n　　联系电话\n　　开放时间\n　　收费标准\n　　三明市东新六路\n　　占地面积达300亩，总建筑面积6.8万平方米，（其中体育场4.3万平方米，体育馆2.5万平方米），绿化率达到30.1%，并有面积", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729836.htm", "docreltime": "2012.09.24 08:33:00", "doctitle": "三明市体育中心", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843998, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729836.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "rels": []}, {"docid2": 1729835, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729835.htm", "content": "\n　　场馆地点\n　　场馆简介\n　　联系电话\n　　开放时间\n　　收费标准\n　　建宁县濉城镇健翔路1号\n　　建宁县体育中心位于建宁县健翔路1号，点地9.7公顷，总投资1.4亿元，主要由体育馆、游泳馆、田径场、青少年校外体", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729835.htm", "docreltime": "2012.09.24 08:27:00", "doctitle": "建宁县体育中心", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843997, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729835.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "rels": []}, {"docid2": 1729834, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729834.htm", "content": "\n　　场馆地点：城区中环大桥北岸。\n　　场馆简介：总占地面积11776.5平方米，建筑面积19536平方米，总投资为1.08亿元。一期为体育场建设，二期为2600座体育馆和室外标准游泳馆建设。一期工程已于2009年8月完工，完成", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729834.htm", "docreltime": "2012.09.19 17:37:00", "doctitle": "宁化县体育中心", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843996, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729834.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "rels": []}, {"docid2": 1729833, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729833.htm", "content": "\n　　场馆地点\n　　场馆简介\n　　联系电话\n　　开放时间\n　　收费标准\n　　三明市三元区城关红印山路。\n　　三明市三元区体育活动中心由训练馆（四层，分别为一层篮球馆、二层跆拳道馆、三层乒乓球馆、四层武术馆）、", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729833.htm", "docreltime": "2012.09.19 17:17:00", "doctitle": "三元区体育活动中心", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1843995, "sourcename": "三明市体育局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729833.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/", "rels": []}, {"docid2": 1729832, "bgxz": "", "chnl": "公共体育场馆", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/gysy/ggtycg/202111/t20211123_1729832.htm", "content": "\n　　场馆地点：泰宁县芦峰街7号\n　　场馆简介：400米标准场地共八个赛道，一个标准足球场，2007年12月铺设人工草皮。\n　　场馆电话：0598-7832953\n　　开放时间：星期一至星期五：夏天5:30----7:30，17:10----19:00", "docabstract": "", "do