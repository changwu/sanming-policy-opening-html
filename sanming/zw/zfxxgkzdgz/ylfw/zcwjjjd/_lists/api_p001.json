{"error": false, "page": 1, "prepage": 100, "pageCount": 1, "recordCount": 33, "data": [{"docid2": 2261824, "bgxz": "", "chnl": "政策文件及解读", "chnldocurl": "http://mzt.fujian.gov.cn/zfxxgkzl/zfxxgkml/gfxwj/ylfw/202605/t20260521_7150549.htm", "content": "", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://mzt.fujian.gov.cn/zfxxgkzl/zfxxgkml/gfxwj/ylfw/202605/t20260521_7150549.htm", "docreltime": "2026.05.29 15:47:00", "doctitle": "关于公布可承接福建省养老机构预收费银行存管业务的商业银行名单的公告", "doctype": 30, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2475443, "sourcename": "", "subdoctitle": "", "type": 30, "url": "http://mzt.fujian.gov.cn/zfxxgkzl/zfxxgkml/gfxwj/ylfw/202605/t20260521_7150549.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "rels": []}, {"docid2": 2184491, "bgxz": "", "chnl": "政策文件及解读", "chnldocurl": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/t20260116_2184491.htm", "content": "\n　　根据《民政部 财政部关于全面启动实施向中度以上失能老年人发放养老服务消费补贴项目的通知》（民发〔2025〕49号），将在全市范围内开展向中度以上失能老年人发放养老服务消费补贴项目（简称补贴项目），现面向", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/t20260116_2184491.htm", "docreltime": "2026.01.16 11:00:00", "doctitle": "三明市民政局关于征集三明市向中度以上失能老年人发放养老服务消费补贴项目服务机构的通告", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 2, "pubdate": "", "puborg": "", "recid": 2394560, "sourcename": "三明市民政局", "subdoctitle": "", "type": 20, "url": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/t20260116_2184491.htm", "ztcx": "", "tpfl": "", "pics": [{"appdesc": "微信图片_20260117110610.jpg", "appdocid": 2184491, "appfile": "W020260116401309806078.jpg", "appflag": 20, "appsern": 1, "docpuburl": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/t20260116_2184491.htm", "fileext": "jpg", "_src": "/webpic/W0202601/W020260116/W020260116401309806078.jpg", "_href": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/W020260116401309806078.jpg"}], "files": [{"appdesc": "附件1：居家社区养老服务补贴项目清单.jpg", "ap