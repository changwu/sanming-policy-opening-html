4491, "appfile": "P020260116400363745387.docx", "appflag": 10, "appsern": 3, "docpuburl": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/t20260116_2184491.htm", "fileext": "docx", "_src": "/protect/P0202601/P020260116/P020260116400363745387.docx", "_href": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/P020260116400363745387.docx"}, {"appdesc": "附件4：养老服务消费补贴项目诚信承诺书.doc", "appdocid": 2184491, "appfile": "P020260116400363912626.doc", "appflag": 10, "appsern": 4, "docpuburl": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/t20260116_2184491.htm", "fileext": "doc", "_src": "/protect/P0202601/P020260116/P020260116400363912626.doc", "_href": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/P020260116400363912626.doc"}], "_docpuburl": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/", "_firstpic": "http://mzj.sm.gov.cn/xwzx/ggzc/202601/W020260116401309806078.jpg", "rels": []}, {"docid2": 2173065, "bgxz": "", "chnl": "老年人福利", "chnldocurl": "http://mzt.fujian.gov.cn/zfxxgkzl/zfxxgkml/gfxwj/ylfw/202510/t20251027_7026023.htm", "content": "", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://mzt.fujian.gov.cn/zfxxgkzl/zfxxgkml/gfxwj/ylfw/202510/t20251027_7026023.htm", "docreltime": "2025.09.03 11:39:00", "doctitle": "福建省老龄工作委员会办公室关于印发《福建省贯彻〈中共中央　国务院关于深化养老服务改革发展的意见〉落实措施》的通知", "doctype": 30, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 2, "pubdate": "", "puborg": "", "recid": 2395794, "sourcename": "", "subdoctitle": "", "type": 30, "url": "http://mzt.fujian.gov.cn/zfxxgkzl/zfxxgkml/gfxwj/ylfw/202510/t20251027_7026023.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "rels": []}, {"docid2": 2187636, "bgxz": "", "chnl": "老年人福利", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/t20260131_2187636.htm", "content": "\n　　80周岁以上老人高龄（津）补贴，按照每人每月不低于50元标准发放，具体标准由各县（市、区）制定；低保对象、计划生育特殊家庭中的完全失能老年人护理补贴，按照每人每月不低于200元标准，以老年人服务券（卡）", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/t20260131_2187636.htm", "docreltime": "2025.05.29 19:39:00", "doctitle": "老年人福利补贴标准（2025年）", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 2, "pubdate": "", "puborg": "", "recid": 2395791, "sourcename": "三明市民政局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/t20260131_2187636.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/", "rels": []}, {"docid2": 2187634, "bgxz": "", "chnl": "老年人福利", "chnldocurl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/t20260131_2187634.htm", "content": "\n　　老人从本人户口所在地的村、居委会提出申请，提供身份证、银行卡复印件等材料，填写申报表格经村、居委会工作人员核实材料（失能老人需到户）后上报到乡镇、街道民政办审批，乡镇、街道民政办审批后上报到县（市", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/t20260131_2187634.htm", "docreltime": "2025.05.29 19:37:00", "doctitle": "老年人福利补贴申领程序（2025年）", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 2, "pubdate": "", "puborg": "", "recid": 2395790, "sourcename": "三明市民政局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/t20260131_2187634.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/zfxxgkzdgz/ylfw/lnrbtslhffxx/202601/", "rels": []}, {"docid2": 2124812, "bgxz": "", "chnl": "老年人福利", "chnldocurl": "http://rsj.sm.gov.cn/szfgzjg/rsj/zfxxgkml/ldgx/202505/t20250522_2124812.htm", "content": "各县（市、区）人力资源和社会保障局（民政和人力资源社会保障局）、发改局、商务局、民政局、教育局、农业农村局、妇联、总工会：\n　　为贯彻落实《福建省促进“一老一小”家政服务发展若干措施》（闽政办〔2024〕2", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://rsj.sm.gov.cn/szfgzjg/rsj/zfxxgkml/ldgx/202505/t20250522_2124812.htm", "docreltime": "2025.05.22 14:58:00", "doctitle": "三明市人力资源和社会保障局等八部门关于印发促进家政服务发展九条措施的通知", "doctype": 20, "efftype": "", "fileno": "明人社〔2025〕111号", "idxid": "SM00113-40-2025-00047", "itvid": "", "moda