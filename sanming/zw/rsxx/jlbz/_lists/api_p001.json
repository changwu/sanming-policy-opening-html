56", "itvid": "", "modal": 2, "pubdate": "2023.04.28 00:00:00", "puborg": "三明市人力资源和社会保障局", "recid": 2093119, "sourcename": "三明市人力资源和社会保障局", "subdoctitle": "", "type": 20, "url": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202305/t20230515_1904788.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [{"appdesc": "附件.docx", "appdocid": 1904788, "appfile": "P020230515551178645582.docx", "appflag": 10, "appsern": 1, "docpuburl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202305/t20230515_1904788.htm", "fileext": "docx", "_src": "/protect/P0202305/P020230515/P020230515551178645582.docx", "_href": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202305/P020230515551178645582.docx"}], "_docpuburl": "http://rsj.sm.gov.cn/xxgk/fgwj/zxwj/202305/", "rels": []}, {"docid2": 1898584, "bgxz": "", "chnl": "奖励表彰", "chnldocurl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202304/t20230423_1898584.htm", "content": "各县（市、区）人民政府，市直各单位：\n2022年，我市先后遭受低温冷冻、风雹、洪涝、滑坡等多次自然灾害，尤其是5月24日至6月19日，金溪、沙溪、尤溪三大流均发生洪水，文川溪遭遇40年一遇大洪水。灾情发生后，全市建", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202304/t20230423_1898584.htm", "docreltime": "2023.04.23 11:19:00", "doctitle": "三明市人民政府关于表扬2022年度建筑业企业抢险救灾先进集体的通报", "doctype": 20, "efftype": "01", "fileno": "明政文〔2023〕26号", "idxid": "SM00100-3000-2023-00235", "itvid": "", "modal": 2, "pubdate": "2023.04.17 00:00:00", "puborg": "三明市人民政府", "recid": 2048664, "sourcename": "政府信息公开办", "subdoctitle": "", "type": 20, "url": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202304/t20230423_1898584.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [{"appdesc": "[原件]明政文〔2023〕26号（关于表扬2022年度建筑业企业抢险救灾先进集体的通报）.ofd", "appdocid": 1898584, "appfile": "P020230424363367884632.ofd", "appflag": 10, "appsern": 1, "docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202304/t20230423_1898584.htm", "fileext": "ofd", "_src": "/protect/P0202304/P020230424/P020230424363367884632.ofd", "_href": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202304/P020230424363367884632.ofd"}], "_docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202304/", "rels": []}, {"docid2": 1895461, "bgxz": "", "chnl": "奖励表彰", "chnldocurl": "http://www.sm.gov.cn/zw/rsxx/jlbz/202304/t20230412_1895461.htm", "content": "\n　　根据中共三明市委办公室、三明市人民政府办公室《关于做好省劳动模范和先进工作者推荐工作的通知》（明委办发明电〔2023〕15号）精神，现将三明市2023年福建省劳动模范和先进工作者推荐人选予以公示（推荐人选基", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/rsxx/jlbz/202304/t20230412_1895461.htm", "docreltime": "2023.04.11 09:00:00", "doctitle": "关于三明市2023年福建省劳动模范和先进工作者推荐人选的公示", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2044053, "sourcename": "三明市总工会网站", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/rsxx/jlbz/202304/t20230412_1895461.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "附件：三明市2023年福建省劳动模范和先进工作者推荐人选汇总表.xls", "appdocid": 1895461, "appfile": "P020230412331659326409.xls", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/rsxx/jlbz/202304/t20230412_1895461.htm", "fileext": "xls", "_src": "/protect/P0202304/P020230412/P020230412331659326409.xls", "_href": "http://www.sm.gov.cn/zw/rsxx/jlbz/202304/P020230412331659326409.xls"}], "_docpuburl": "http://www.sm.gov.cn/zw/rsxx/jlbz/202304/", "rels": []}, {"docid2": 1846673, "bgxz": "", "chnl": "奖励表彰", "chnldocurl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202211/t20221115_1846673.htm", "content": "各县（市、区）人民政府，市直各单位：\n　　为深入践行社会主义核心价值观，大力弘扬社会正气，倡导见义勇为精神，根据《福建省奖励和保护见义勇为人员条例》，决定授予陈杰等6位同志“三明市见义勇为模范”荣誉称号", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202211/t20221115_1846673.htm", "docreltime": "2022.11.15 16:36:00", "doctitle": "关于授予陈杰等同志见义勇为模范的决定", "doctype": 20, "efftype": "01", "fileno": "明政文〔2022〕102号", "idxid": "SM00100-3000-2022-00234", "itvid": "", "modal": 2, "pubdate": "2022.11.08 00:00:00", "puborg": "三明市人民政府", "recid": 1982147, "sourcename": "政府信息公开办", "subdoctitle": "", "type": 20, "url": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202211/t20221115_1846673.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [{"appdesc": "[原件]明政文〔2022〕102号（关于授予陈杰等同志见义勇为模范的决定）.ofd", "appdocid": 1846673, "appfile": "P020221115599116125347.ofd", "appflag": 10, "appsern": 1, "docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202211/t20221115_1846673.htm", "fileext": "ofd", "_src": "/protect/P0202211/P020221115/P020221115599116125347.ofd", "_href": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202211/P020221115599116125347.ofd"}], "_docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202211/", "rels": []}, {"docid2": 1826427, "bgxz": "", "chnl": "奖励表彰", "chnldocurl": "http://www.sm.gov.cn/zw/rsxx/jlbz/202209/t20220907_1826427.htm", "content": "\n　　各县（市、区）党委和人民政府，市直各单位：\n　　近年来，全市广大教师和教育工作者坚持以习近平新时代中国特色社会主义思想为指导，深入学习贯彻习近平总书记关于教育的重要论述和来闽、来明考察重要讲话重要", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/rsxx/jlbz/202209/t20220907_1826427.htm", "docreltime": "2022.09.07 15:32:00", "doctitle": "中共三明市委三明市人民政府关于表彰2022年三明市优秀教师和教育系统先进集体及先进个人的决定", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 1957384, "sourcename": "e三明", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/rsxx/jlbz/202209/t20220907_1826427.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/rsxx/jlbz/202209/", "rels": []}, {"docid2": 1822889, "bgxz": "", "chnl": "奖励表彰", "chnldocurl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202208/t20220828_1822889.htm", "content": "各县（市、区）人民政府，市直各单位：\n2021年8月30日，三明市人民政府、三明市第一医院分别与中山大学附属第一医院（以下简称“中山一院”）签订合作共建协