0", "itvid": "", "modal": 2, "pubdate": "2023.11.06 00:00:00", "puborg": "三明市人民政府", "recid": 2167727, "sourcename": "政府信息公开办", "subdoctitle": "", "type": 20, "url": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202311/t20231114_1975221.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [], "_docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/qtyzdgkdzfxx/202311/", "rels": []}, {"docid2": 1975058, "bgxz": "", "chnl": "2023年第6期", "chnldocurl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/fpjyylshbzcjjydfmdzccsjqssqk/202311/t20231114_1975058.htm", "content": "各县（市、区）人民政府，市直有关单位：\n　　现将《三明市推进基本养老服务体系建设实施方案》印发给你们，请认真组织实施。\n　　三明市人民政府办公室\n　　2023年11月2日\n　　三明市推进基本养老服务体系建设实施方", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/fpjyylshbzcjjydfmdzccsjqssqk/202311/t20231114_1975058.htm", "docreltime": "2023.11.14 10:22:00", "doctitle": "三明市人民政府办公室关于印发三明市推进基本养老服务体系建设实施方案的通知", "doctype": 20, "efftype": "", "fileno": "明政办〔2023〕24号", "idxid": "SM00101-1000-2023-00341", "itvid": "", "modal": 2, "pubdate": "2023.11.02 00:00:00", "puborg": "三明市人民政府办公室", "recid": 2167726, "sourcename": "市政府办", "subdoctitle": "", "type": 20, "url": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/fpjyylshbzcjjydfmdzccsjqssqk/202311/t20231114_1975058.htm", "ztcx": "有效", "tpfl": "", "pics": [], "files": [{"appdesc": "明政办〔2023〕24号（三明市人民政府办公室关于印发三明市推进基本养老服务体系建设实施方案的通知）.ofd", "appdocid": 1975058, "appfile": "P020231114380122851835.ofd", "appflag": 10, "appsern": 1, "docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/fpjyylshbzcjjydfmdzccsjqssqk/202311/t20231114_1975058.htm", "fileext": "ofd", "_src": "/protect/P0202311/P020231114/P020231114380122851835.ofd", "_href": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/fpjyylshbzcjjydfmdzccsjqssqk/202311/P020231114380122851835.ofd"}], "_docpuburl": "https://www.sm.gov.cn/smsrmzfbgs/smsrmzf/zfxxgkml/fpjyylshbzcjjydfmdzccsjqssqk/202311/", "rels": [