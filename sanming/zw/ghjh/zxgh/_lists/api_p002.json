ect/P0201605/P020160520/P020160520349950731830.xls", "_href": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/P020160520349950731830.xls"}, {"appdesc": "三明市区2011住房建设规划年度计划说明书.doc", "appdocid": 227874, "appfile": "P020160520349950887750.doc", "appflag": 10, "appsern": 3, "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/t20110504_227874.htm", "fileext": "doc", "_src": "/protect/P0201605/P020160520/P020160520349950887750.doc", "_href": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/P020160520349950887750.doc"}, {"appdesc": "2011年度规划计划目录.doc", "appdocid": 227874, "appfile": "P020160520349951049950.doc", "appflag": 10, "appsern": 4, "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/t20110504_227874.htm", "fileext": "doc", "_src": "/protect/P0201605/P020160520/P020160520349951049950.doc", "_href": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/P020160520349951049950.doc"}, {"appdesc": "2011年度保障性住房项目一览表.xls", "appdocid": 227874, "appfile": "P020160520349951202764.xls", "appflag": 10, "appsern": 5, "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/t20110504_227874.htm", "fileext": "xls", "_src": "/protect/P0201605/P020160520/P020160520349951202764.xls", "_href": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/P020160520349951202764.xls"}], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201105/", "rels": []}, {"docid2": 227019, "bgxz": "", "chnl": "专项规划", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/t20110331_227019.htm", "content": "\n　　一是加强与港澳投资贸易促进机构的联系，构建互动招商平台，推进明港澳经贸、旅游、物流、金融等领域合作。二是加强同海外华侨华人及社团的联络和沟通，积极引进侨智侨力，鼓励归国人员自主创业，大力推动海外侨", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/t20110331_227019.htm", "docreltime": "2011.03.30 16:17:00", "doctitle": "我市“十二五”规划将进一步深化明港澳侨合作和实施“走出去”战略", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 229095, "sourcename": "三明市外事侨务办", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/t20110331_227019.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/", "rels": []}, {"docid2": 226523, "bgxz": "", "chnl": "专项规划", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/t20110314_226523.htm", "content": "\n　　一是在闽江流域农村环境连片整治示范区村庄实施“三清一整治”工程，使农村饮用水卫生合格率达95%以上、村庄生活污水处理率不低于70%、村庄生活垃圾收集率达100%、无害化处理率达到90%以上、畜禽养殖废弃物综合", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/t20110314_226523.htm", "docreltime": "2011.03.14 17:44:00", "doctitle": "我市2011-2013年将实施“三大工程”推进农村环境综合整治", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 228599, "sourcename": "三明市农办", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/t20110314_226523.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201103/", "rels": []}, {"docid2": 221750, "bgxz": "", "chnl": "专项规划", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201008/t20100809_221750.htm", "content": "\n　　各县（市、区）人民政府，市直有关单位：\n　　《三明市2010-2012年文化产业项目推进计划》已经市政府常务会议研究并报市委同意，现印发给你们，请结合各自实际，认真抓好贯彻落实。\n　　三明市人民政府\n　　二〇", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201008/t20100809_221750.htm", "docreltime": "2010.08.09 11:35:00", "doctitle": "三明市人民政府关于印发三明市2010-2012年文化产业项目推进计划的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 223825, "sourcename": "", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/zxgh/201008/t20100809_221750.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201008/", "rels": []}, {"docid2": 221046, "bgxz": "", "chnl": "专项规划", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201007/t20100720_221046.htm", "content": "\n　　各县（市、区）人民政府，市直各单位：\n　　经市政府研究，现将《三明市推进省小城镇综合改革建设试点镇和市中心乡镇发展的实施方案》印发给你们，请认真贯彻执行。\n　　三明市人民政府\n　　二〇一〇年七月八日", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201007/t20100720_221046.htm", "docreltime": "2010.07.16 17:14:00", "doctitle": "三明市人民政府关于印发三明市推进省小城镇综合改革建设试点镇和市中心乡镇发展的实施方案的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 223121, "sourcename": "", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/zxgh/201007/t20100720_221046.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201007/", "rels": []}, {"docid2": 211708, "bgxz": "", "chnl": "专项规划", "chnldocurl": "http://www.shb.gov.cn/Article_Show.asp?ArticleID=4457", "content": "", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.shb.gov.cn/Article_Show.asp?ArticleID=4457", "docreltime": "2009.07.20 11:17:00", "doctitle": "《三明市县城饮用水水源地环境保护规划》编制大纲", "doctype": 30, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 213783, "sourcename": "三明市环保网", "subdoctitle": "", "type": 30, "url": "http://www.shb.gov.cn/Article_Show.asp?ArticleID=4457", "ztcx": "", "tpfl": "", "pics": [], "files": [], "rels": []}, {"docid2": 211514, "bgxz": "", "chnl": "专项规划", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/zxgh/200907/t20090713_211514.htm", "content": "\n　　第一章总则\n　　第一条　规划目的\n　　解决三明市区低收入住房困难家庭的基本住房问题，逐步改善低收入家庭住房条件。\n　　第二条规划依据\n　　1.三明市国民经济与社会发展“十一五”规划\n　　2.三明市城市总体", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/200907/t20090713_211514.htm", "docreltime": "2009.07.13 16:44:00", "doctitle": "三明市区解决城市低收入家庭住房困难发展规划和年度计划", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 213589, "sourcename": "", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/zxgh/200907/t