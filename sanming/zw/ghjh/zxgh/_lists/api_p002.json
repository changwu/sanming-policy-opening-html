.gov.cn/zw/ghjh/zxgh/201208/t20120820_240756.htm", "content": "\n　　", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201208/t20120820_240756.htm", "docreltime": "2012.08.20 17:17:00", "doctitle": "三明市“十二五”基础测绘专项规划", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 242832, "sourcename": "三明市国土资源局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/zxgh/201208/t20120820_240756.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "三明市“十二五”基础测绘专项规划.doc", "appdocid": 240756, "appfile": "P020160520428366007317.doc", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201208/t20120820_240756.htm", "fileext": "doc", "_src": "/protect/P0201605/P020160520/P020160520428366007317.doc", "_href": "http://www.sm.gov.cn/zw/ghjh/zxgh/201208/P020160520428366007317.doc"}], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201208/", "rels": []}, {"docid2": 235108, "bgxz": "", "chnl": "专项规划", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201203/t20120305_235108.htm", "content": "\n　　前言\n　　为深入贯彻落实《福建省人民政府关于加强重点流域水环境综合整治的意见》（闽政〔2009〕16号）、《福建省人民政府办公厅关于认真做好水产养殖水域规划工作的通知》（闽政办〔2011〕235号）和《三明市人", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201203/t20120305_235108.htm", "docreltime": "2012.03.05 09:45:00", "doctitle": "街面水库养殖水域规划", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 237184, "sourcename": "", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/zxgh/201203/t20120305_235108.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "街面水库养殖水域规划.doc", "appdocid": 235108, "appfile": "P020160520414685857569.doc", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/ghjh/zxgh/201203/t20120305_235108.htm", "fileext": "doc", "_src": "/protect/P0201605/P0201