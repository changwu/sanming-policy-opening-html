d": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2246283, "sourcename": "福建省工业和信息化厅", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/ghjd/202409/t20240920_2062134.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/ghjd/202409/", "rels": []}, {"docid2": 2010424, "bgxz": "", "chnl": "规划解读", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/ghjd/202403/t20240319_2010424.htm", "content": "\n　　2024年2月19日，福建省人民政府第25次常务会议审议通过《福建省开发区管理办法》（以下简称《办法》），将于2024年5月1日起施行。《办法》的制定出台，有利于引导开发区产业转型升级、科技自立自强、绿色低碳转", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/ghjd/202403/t20240319_2010424.htm", "docreltime": "2024.03.19 09:01:00", "doctitle": "《福建省开发区管理办法》政策解读", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2182712, "sourcename": "福建省人民政府门户网站", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ghjh/ghjd/202403/t20240319_2010424.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "图表：国务院印发《推动大规模设备更新和消费品以旧换新行动方案》", "appdocid": 2010424, "appfile": "https://www.gov.cn/zhengce/jiedu/tujie/202403/content_6939360.htm", "appflag": 40, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/ghjh/ghjd/202403/t20240319_2010424.htm", "fileext": "", "_href": "http://www.sm.gov.cn/zw/ghjh/ghjd/202403/https://www.gov.cn/zhengce/jiedu/tujie/202403/content_6939360.htm"}], "_docpuburl": "http://www.sm.gov.cn/zw/ghjh/ghjd/202403/", "rels": []}, {"docid2": 1990994, "bgxz": "", "chnl": "规划解读", "chnldocurl": "http://www.sm.gov.cn/zw/ghjh/ghjd/202401/t20240103_1990994.htm", "content": "\n　　近日，福建省人民政府批复《福建省水网建设规划》（以下简称《规划》）。《规划》依据中共中央、国务院印发的《国家水网建设规划纲要》和水利部《关于加快推进省级水网建设的指导意见》等文件编制。《规划》立足", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ghjh/ghjd/202401/t20240103_1990994.htm", "docreltime": "2023.09.18 10:20:00", "doctitle": "《福建省水网建设规划》解读", "doctype": 20, "