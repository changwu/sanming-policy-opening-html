{"error": false, "page": 1, "prepage": 100, "pageCount": 1, "recordCount": 1, "data": [{"docid2": 227478, "bgxz": "", "chnl": "文明城市大看台", "chnldocurl": "http://www.sm.gov.cn/zw/ztzl/cjwmcsgzzl/wmcsdkt/201104/t20110419_227478.htm", "content": "\n　　三明市位于福建省西北部，是一座山清水秀、充满活力的新兴城市，总面积2.29万平方公里，现辖2区1市9县，总人口270万人，其中市区常住人口30万。上世纪八十年代初，三明市在全国首开群众性精神文明创建活动先河，", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ztzl/cjwmcsgzzl/wmcsdkt/201104/t20110419_227478.htm", "docreltime": "2011.04.19 11:20:00", "doctitle": "三明市创建文明城市概况", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 229554, "sourcename": "", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ztzl/cjwmcsgzzl/wmcsdkt/201104/t20110419_227478.htm", "ztcx": "", "tpfl": "", "pics": [{"appdesc": "00.jpg", "appdocid": 227478, "appfile": "W020160520349251027827.jpg", "appflag": 20, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/ztzl/cjwmcsgzzl/wmcsdkt/201104/t20110419_227478.htm", "fileext": "jpg", "_src": "/webpic/W0201605/W020160520/W020160520349251027827.jpg", "_href": "http://www.sm.gov.cn/zw/ztzl/cjwmcsgzzl/wmcsdkt/201104/W020160520349251027827.jpg"}], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ztzl/cjwmcsgzzl/wmcsdkt/201104/", "_firstpic": "http://www.sm.gov.cn/zw/ztzl/cjwmcsgzzl/wmcsdkt/201104/W020160520349251027827.jpg", "rels": []}]}