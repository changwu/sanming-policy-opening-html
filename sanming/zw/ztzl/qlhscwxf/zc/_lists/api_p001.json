": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2122027, "sourcename": "市住房和城乡建设局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960196.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/", "rels": [{"reldocid": 1871302, "docid2": 1960196, "sern": 1, "srcdocpeople": "", "srcdocpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960196.htm", "srcdocreltime": "2023-02-02 18:56:00", "srcdoctitle": "印发《关于支持三元区房地产市场平稳健康发展的七条政策措施》的通知", "tardocpeople": "", "tardocpuburl": "http://zjj.sm.gov.cn/xxgk/zcjd/202301/t20230111_1871302.htm", "tardocreltime": "2023-01-11 09:28:00", "tardoctitle": "《关于支持三明三元区房地产市场平稳健康发展的七条政策措施》的政策解读"}]}, {"docid2": 1960195, "bgxz": "", "chnl": "政策/解读", "chnldocurl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960195.htm", "content": "\n　　明建规〔2022〕2号\n　　各县（市、区）住建局，各房地产开发企业：\n　　根据“保交楼、保民生、保稳定”的原则，为规范商品房销售行为，防范预售资金被挪用、侵占现象发生，确保商品房预售资金可及时足额存入指", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960195.htm", "docreltime": "2022.08.25 17:08:00", "doctitle": "关于加强购房事项提示及预售资金缴交告知工作的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2122026, "sourcename": "市住房和城乡建设局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960195.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [{"appdesc": "明建规〔2022〕2号附件.docx", "appdocid": 1960195, "appfile": "P020231007347057245261.docx", "appflag": 10, "appsern": 1, "docpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960195.htm", "fileext": "docx", "_src": "/protect/P0202310/P020231007/P020231007347057245261.docx", "_href": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/P020231007347057245261.docx"}], "_docpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/", "rels": [{"reldocid": 1826141, "docid2": 1960195, "sern": 1, "srcdocpeople": "", "srcdocpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960195.htm", "srcdocreltime": "2022-08-25 17:08:00", "srcdoctitle": "关于加强购房事项提示及预售资金缴交告知工作的通知", "tardocpeople": "", "tardocpuburl": "http://zjj.sm.gov.cn/xxgk/zcjd/202209/t20220906_1826141.htm", "tardocreltime": "2022-08-24 17:34:00", "tardoctitle": "《三明市住房和城乡建设局关于加强购房事项提示及预售资金缴交告知工作的通知》政策解读"}]}, {"docid2": 1960194, "bgxz": "", "chnl": "政策/解读", "chnldocurl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960194.htm", "content": "\n　　明建〔2022〕15号\n　　各县（市、区）人民政府，市直各单位：\n　　为推进房地产市场平稳健康发展，结合我市实际，经市政府同意，自本通知发布之日起，暂停执行《三明市人民政府办公室关于加强房地产市场调控的通", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960194.htm", "docreltime": "2022.05.09 11:29:00", "doctitle": "关于调整《三明市人民政府办公室关于加强房地产市场调控的通知》有关规定的通知", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2122025, "sourcename": "市住房和城乡建设局", "subdoctitle": "", "type": 20, "url": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960194.htm", "ztcx": "", "tpfl": "", "pics": [], "files": [], "_docpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/", "rels": []}, {"docid2": 1960177, "bgxz": "", "chnl": "政策/解读", "chnldocurl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960177.htm", "content": "\n　　为培育一批发展潜力大、竞争实力强的限上商贸流通企业，提升我市商贸流通业发展水平，提高商贸流通业对第三产业发展和地方税收的贡献度，挖掘经济新增长点，结合我市实际，制定以下措施。  \n　　（详见附件）\n　", "docabstract": "", "doclogo": "", "docpeople": "", "docpuburl": "http://www.sm.gov.cn/zw/ztzl/qlhscwxf/zc/202310/t20231007_1960177.htm", "docreltime": "2022.04.26 09:20:00", "doctitle": "三明市促进商贸流通业加快发展若干措施", "doctype": 20, "efftype": "", "fileno": "", "idxid": "", "itvid": "", "modal": 1, "pubdate": "", "puborg": "", "recid": 2122006, 